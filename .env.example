# Set production when running the API behind a public HTTPS endpoint.
ENVIRONMENT=development
# Comma-separated browser origins. Set only the deployed frontend origin in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_BYTES=5242880
REQUEST_TIMEOUT_SECONDS=5
MAX_REDIRECTS=5
# External reputation requests are off unless explicitly enabled. They disclose submitted URLs.
ENABLE_EXTERNAL_INTEL=false
VIRUS_TOTAL_API_KEY=
# Public build-time URL used by the Dockerized frontend. It is not a secret.
# For a deployed frontend/API pair, use the public HTTPS API URL, e.g. https://api.example.com
VITE_API_BASE=http://localhost:8000
